{
  "manifest_version": 3,
  "name": "Base de connaissance",
  "version": "1.0.0",
  "description": "Ajoute la page consultée à ta base de connaissance locale, avec une note personnelle.",

  "action": {
    "default_popup": "popup.html",
    "default_title": "Ajouter cette page à la base",
    "default_icon": {
      "16": "icone-16.png",
      "32": "icone-32.png",
      "48": "icone-48.png",
      "128": "icone-128.png"
    }
  },

  "icons": {
    "16": "icone-16.png",
    "32": "icone-32.png",
    "48": "icone-48.png",
    "128": "icone-128.png"
  },

  "permissions": ["activeTab"],

  "host_permissions": ["http://localhost:3000/*"],

  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+K" },
      "description": "Ouvrir la fenêtre d'ajout"
    }
  }
}
