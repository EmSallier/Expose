# Copier ce fichier en .env puis remplir les valeurs.
# Le .env est ignore par Git : ces cles ne partiront jamais sur GitHub.

# --- Supabase ---
# Tableau de bord Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Recherche web (Tavily) ---
# Cle gratuite sur https://app.tavily.com
TAVILY_API_KEY=
